#!/usr/bin/env sh
set -eu

fish_path="${FISH_PATH:-}"

if [ -z "$fish_path" ]; then
  if command -v fish >/dev/null 2>&1; then
    fish_path="$(command -v fish)"
  elif [ -x /opt/homebrew/bin/fish ]; then
    fish_path="/opt/homebrew/bin/fish"
  elif [ -x /usr/local/bin/fish ]; then
    fish_path="/usr/local/bin/fish"
  else
    printf '%s\n' "fish was not found. Install it first, then rerun this script." >&2
    exit 1
  fi
fi

if [ ! -x "$fish_path" ]; then
  printf 'fish shell is not executable: %s\n' "$fish_path" >&2
  exit 1
fi

if ! grep -Fxq "$fish_path" /etc/shells; then
  printf 'Adding %s to /etc/shells...\n' "$fish_path"
  printf '%s\n' "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi

current_shell="${SHELL:-}"

if [ "$current_shell" = "$fish_path" ]; then
  printf 'Default shell is already %s\n' "$fish_path"
  exit 0
fi

printf 'Changing default shell to %s...\n' "$fish_path"
chsh -s "$fish_path"
printf '%s\n' "Done. Open a new terminal session to start using fish by default."
